AWS_REGION=us-east-1
OS_SERVICE_BASE_URL=http://host.docker.internal:8081
# Credenciais locais opcionais. No EKS, use IRSA em vez de chaves estáticas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
EVENT_FOR_DIAGNOSTICS_QUEUE=eventForDiagnostics
EVENT_DIAGNOSIS_QUEUE=eventDiagnosis
EVENT_EXECUTION_STARTED_QUEUE=eventExecutionStarted
EVENT_FOR_OS_COMPLETED_QUEUE=eventForOsCompleted
APPROVAL_QUEUE=productionApproval
EVENT_DIAGNOSIS_COMPLETED_QUEUE=eventDiagnosisCompleted
SUPPLY_DATABASE=officyna_supply
LABOR_DATABASE=officyna_labor
SNAPSHOT_DATABASE=officyna_snapshot
JWT_SECRET=officyna-secret-key-change-in-production-min-256bits
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=production-execution-service
PRODUCTION_EXECUTION_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/production-execution-service
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/github-actions-production-execution
DOCDB_ENDPOINT_PARAMETER=/officyna/db/endpoint
DOCDB_USERNAME=officynasoatdbuser
K8S_NAMESPACE=officyna
EKS_CLUSTER_NAME=eks-officyna-service
